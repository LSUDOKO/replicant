NEXT_PUBLIC_0G_NETWORK=galileo
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_0G_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Fill these after `forge script script/DeployReplicant.s.sol:DeployReplicant --rpc-url $ZERO_G_GALILEO_RPC_URL --broadcast`.
NEXT_PUBLIC_AGENT_ID_CONTRACT=
NEXT_PUBLIC_EVOLUTION_COORDINATOR_CONTRACT=
NEXT_PUBLIC_MARKETPLACE_CONTRACT=
NEXT_PUBLIC_SUBSCRIPTION_ESCROW_CONTRACT=

# Base URL for tokenURI — must end with /. Block explorers (chainscan-galileo) will fetch
# <METADATA_BASE_URI><tokenId> to display NFT metadata. Set this to your deployed app URL.
# Example: https://your-app.vercel.app/api/metadata/
# Used by DeployReplicant.s.sol (sets it at deploy time) and SetBaseURI.s.sol (post-deploy).
METADATA_BASE_URI=

# Optional if a Superfluid deployment is available on the selected 0G network.
NEXT_PUBLIC_SUPERFLUID_HOST=
NEXT_PUBLIC_SUPERFLUID_CFA=

# WalletConnect (RainbowKit). Get your own at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Server/deployment only.
ZERO_G_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_MAINNET_RPC_URL=https://evmrpc.0g.ai
# Private key for 0G Storage uploads (can be same as PRIVATE_KEY)
ZERO_G_STORAGE_PRIVATE_KEY=
# Private key for contract interactions
PRIVATE_KEY=

# Optional: OpenRouter for real LLM-based sentiment analysis (fallback if not set uses rule-based)
# Get your key at https://openrouter.ai/settings
OPENROUTER_API_KEY=

# Optional: Discord bot for AlphaHunter sentiment scraping and signal broadcasting
# Get token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Channel IDs to scrape sentiment from (comma-separated, e.g., "1234567890123456789,9876543210987654321")
DISCORD_CHANNEL_IDS=

# Optional: Farcaster sentiment scraping via Neynar API (FREE tier)
# Get your key at https://neynar.com
NEYNAR_API_KEY=

# Optional: Etherscan API for whale tracking (FREE tier)
# Get your key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: Cron secret for autonomous signal generation endpoint
# Generate a random string and use it in your cron job: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ─── Foundry Protocol (optional) ───────────────────────────────────────
# Route a species through a community-owned, verifiable, revenue-generating
# model (an "Ingot") served over 0G Compute instead of centralized OpenRouter.
# Docs: https://foundryprotocol.xyz · see docs/foundry-integration.md
#
# Bind a species to an Ingot by address or `ingot:0x...` id. Any species left
# unset keeps using the existing inference path (fully non-breaking).
FOUNDRY_INGOT_ALPHA_HUNTER=
FOUNDRY_INGOT_CODE_WEAVER=
FOUNDRY_INGOT_GAME_MASTER=
FOUNDRY_INGOT_DOCU_MIND=
FOUNDRY_INGOT_ORACLE_KEEPER=
FOUNDRY_INGOT_SOCIAL_SYNTH=
# Optional overrides (sane mainnet defaults if unset)
FOUNDRY_RPC_URL=
FOUNDRY_INFERENCE_ENDPOINT=
FOUNDRY_API_KEY=
